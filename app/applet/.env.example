# Variables de entorno requeridas
# Clave privada del Service Account de Firebase. Necessario para operaciones de backend como db.recursiveDelete() o auth.deleteUser().
# Obtén este archivo JSON desde la consola de Firebase: Project Settings > Service Accounts > Generate new private key
# Pega todo el contenido del JSON en el valor de esta variable en la pestaña Secrets de AI Studio.
FIREBASE_SERVICE_ACCOUNT=
# Configuración SMTP - Utilizado para correos de bienvenida (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# URL de API para pagos Flow
FLOW_API_URL=
FLOW_API_KEY=
FLOW_SECRET_KEY=
# URL de la web externa para redirecciones de pago (si aplica)
APP_URL=
